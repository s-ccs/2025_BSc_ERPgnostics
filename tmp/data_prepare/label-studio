#!/usr/bin/env bash
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
PY312_LIB="$ROOT_DIR/.tools/python312/usr/lib"
LABEL_STUDIO_BIN="$ROOT_DIR/.venvs/labelstudio/bin/label-studio"

export LD_LIBRARY_PATH="$PY312_LIB${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"
export LABEL_STUDIO_BASE_DATA_DIR="${LABEL_STUDIO_BASE_DATA_DIR:-$ROOT_DIR/.label-studio-data}"
export LOCAL_FILES_SERVING_ENABLED="${LOCAL_FILES_SERVING_ENABLED:-${LABEL_STUDIO_LOCAL_FILES_SERVING_ENABLED:-true}}"
export LOCAL_FILES_DOCUMENT_ROOT="${LOCAL_FILES_DOCUMENT_ROOT:-${LABEL_STUDIO_LOCAL_FILES_DOCUMENT_ROOT:-$ROOT_DIR/notebooks/model_test}}"
# Backward-compatible mirrors for older wrappers/configs
export LABEL_STUDIO_LOCAL_FILES_SERVING_ENABLED="$LOCAL_FILES_SERVING_ENABLED"
export LABEL_STUDIO_LOCAL_FILES_DOCUMENT_ROOT="$LOCAL_FILES_DOCUMENT_ROOT"
export DJANGO_DB="${DJANGO_DB:-sqlite}"
export LATEST_VERSION_CHECK="${LATEST_VERSION_CHECK:-false}"
export SENTRY_DSN="${SENTRY_DSN:-}"
export FRONTEND_SENTRY_DSN="${FRONTEND_SENTRY_DSN:-}"

mkdir -p "$LABEL_STUDIO_BASE_DATA_DIR"

# If an explicit SQLite path is passed, ensure its parent directory exists.
db_path=""
prev=""
for arg in "$@"; do
  if [ "$prev" = "--database" ] || [ "$prev" = "-db" ]; then
    db_path="$arg"
    break
  fi
  prev="$arg"
done
if [ -n "$db_path" ]; then
  mkdir -p "$(dirname "$db_path")"
fi

exec "$LABEL_STUDIO_BIN" "$@"
